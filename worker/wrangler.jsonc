{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-prime",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "vars": {
    "ALLOWED_ORIGIN": "https://newgeekhere.github.io"
    // Configure these values for the Cloudflare Access application before enabling writes:
    // "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    // "ACCESS_AUD": "<application-aud>",
    // "ACCESS_ALLOWED_EMAILS": "<authorized-email>"
  },
  "r2_buckets": [
    { "binding": "FICHES", "bucket_name": "formation-s4-donnees-mon-groupe" },
    { "binding": "COMMENTAIRES", "bucket_name": "formation-s4-donnees-mon-groupe" }
  ]
}
